{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch & Debug astra-aviation-rag",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "-p", "4400"],
      "cwd": "${workspaceFolder}/apps/astra-aviation-rag",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "sourceMapPathOverrides": {
        "webpack://server/*": "${workspaceFolder}/*",
        "webpack://client/*": "${workspaceFolder}/*",
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///*": "${workspaceFolder}/*",
        "webpack://[name]/./*": "${workspaceFolder}/*",
        "webpack://[name]/*": "${workspaceFolder}/*",
        "turbopack://[project]/apps/astra-aviation-rag/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "turbopack://[project]/libs/*": "${workspaceFolder}/libs/*",
        "turbopack://[project]/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "turbopack:///./*": "${workspaceFolder}/*",
        "turbopack:///_N_E/*": "${workspaceFolder}/*"
      },
      "serverReadyAction": {
        "pattern": "Local:\\s*(https?://.+)",
        "uriFormat": "%s",
        "action": "startDebugging",
        "name": "Launch Chrome: astra-aviation-rag"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome: astra-aviation-rag",
      "url": "http://localhost:4400",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "webRoot": "${workspaceFolder}/apps/astra-aviation-rag",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "webpack:///./*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "webpack:///*": "${workspaceFolder}/*"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to astra-aviation-rag",
      "port": 9229,
      "cwd": "${workspaceFolder}/apps/astra-aviation-rag",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMapPathOverrides": {
        "webpack://server/*": "${workspaceFolder}/*",
        "webpack://client/*": "${workspaceFolder}/*",
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///*": "${workspaceFolder}/*",
        "webpack://[name]/./*": "${workspaceFolder}/*",
        "webpack://[name]/*": "${workspaceFolder}/*",
        "turbopack://[project]/apps/astra-aviation-rag/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "turbopack://[project]/libs/*": "${workspaceFolder}/libs/*",
        "turbopack://[project]/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "turbopack:///./*": "${workspaceFolder}/*",
        "turbopack:///_N_E/*": "${workspaceFolder}/*"
      }
    },
