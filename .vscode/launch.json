{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch & Debug astra-aviation-rag",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "run", "astra-aviation-rag:dev:debug"],
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "sourceMapPathOverrides": {
        "turbopack://[project]/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "turbopack:///./*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "turbopack:///_N_E/*": "${workspaceFolder}/apps/astra-aviation-rag/*",
        "webpack://_N_E/*": "${workspaceFolder}/apps/astra-aviation-rag/*"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch & Debug astra-document-summary",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "run", "astra-document-summary:dev:debug"],
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "sourceMapPathOverrides": {
        "turbopack://[project]/*": "${workspaceFolder}/apps/astra-document-summary/*",
        "turbopack:///./*": "${workspaceFolder}/apps/astra-document-summary/*",
        "turbopack:///_N_E/*": "${workspaceFolder}/apps/astra-document-summary/*",
        "webpack://_N_E/*": "${workspaceFolder}/apps/astra-document-summary/*"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug standalone-counting-tokens-openai with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "execute", "standalone-counting-tokens-openai"],
      "env": {
        "NODE_OPTIONS": "--inspect=9230"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/standalone/counting-tokens-openai/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
